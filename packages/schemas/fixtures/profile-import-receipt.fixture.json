{
  "$schema": "profile-import-receipt.schema.json",
  "schema_version": "harbor-profile-import-receipt/v1",
  "idempotency_key": "run:synthetic-profile-import",
  "request_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "source_ref": "profile-source:synthetic",
  "target_profile_ref": "profile:managed-target",
  "target_identity_environment_ref": "identity-environment:managed-target",
  "report": {
    "schema_version": "harbor-profile-import-report/v1",
    "status": "partial",
    "imported": { "bookmarks": 1, "folders": 2 },
    "skipped": { "bookmarks": 0, "folders": 0, "separators": 1, "unsafe_urls": 0 },
    "repair_status": "not_attempted",
    "requires_login": true,
    "exclusions": ["history", "cookies", "logins", "extensions", "provider_configuration", "account_binding", "runtime_runs"]
  }
}
