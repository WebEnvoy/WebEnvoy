{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.webenvoy.dev/core/account-system-owner-operation-request.v1.schema.json",
  "title": "WebEnvoy Core owner AccountSystem operation request",
  "description": "Owner-only Core HTTP envelope for importing and managing a user-local public AccountSystem definition. The definition field is validated against the exact pinned Lode template contract by Core.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/importTemplate" },
    { "$ref": "#/$defs/list" },
    { "$ref": "#/$defs/createDraft" },
    { "$ref": "#/$defs/updateDraft" },
    { "$ref": "#/$defs/checkDraft" },
    { "$ref": "#/$defs/pinDraft" },
    { "$ref": "#/$defs/enable" },
    { "$ref": "#/$defs/disable" },
    { "$ref": "#/$defs/rollback" },
    { "$ref": "#/$defs/resolve" }
  ],
  "$defs": {
    "textRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "recordVersion": { "type": "integer", "minimum": 0 },
    "base": { "type": "object", "required": ["operation", "schema_version"], "properties": { "operation": { "type": "string" }, "schema_version": { "const": "webenvoy.account-system-owner-operation/v1" } } },
    "importTemplate": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["template_ref"], "properties": { "operation": { "const": "import_template" }, "template_ref": { "type": "string", "pattern": "^lode://account-system/[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+\\.[0-9]+$" } } }], "unevaluatedProperties": false },
    "list": { "type": "object", "additionalProperties": false, "required": ["schema_version", "operation"], "properties": { "schema_version": { "const": "webenvoy.account-system-owner-operation/v1" }, "operation": { "const": "list" } } },
    "createDraft": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["local_definition_ref", "base_revision_ref"], "properties": { "operation": { "const": "create_draft" }, "local_definition_ref": { "$ref": "#/$defs/textRef" }, "base_revision_ref": { "$ref": "#/$defs/textRef" } } }], "unevaluatedProperties": false },
    "updateDraft": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["draft_ref", "definition"], "properties": { "operation": { "const": "update_draft" }, "draft_ref": { "$ref": "#/$defs/textRef" }, "definition": { "type": "object" } } }], "unevaluatedProperties": false },
    "checkDraft": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["draft_ref"], "properties": { "operation": { "const": "check_draft" }, "draft_ref": { "$ref": "#/$defs/textRef" } } }], "unevaluatedProperties": false },
    "pinDraft": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["draft_ref", "expected_record_version"], "properties": { "operation": { "const": "pin_draft" }, "draft_ref": { "$ref": "#/$defs/textRef" }, "expected_record_version": { "$ref": "#/$defs/recordVersion" } } }], "unevaluatedProperties": false },
    "enable": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["local_definition_ref", "revision_ref", "expected_record_version"], "properties": { "operation": { "const": "enable" }, "local_definition_ref": { "$ref": "#/$defs/textRef" }, "revision_ref": { "$ref": "#/$defs/textRef" }, "expected_record_version": { "$ref": "#/$defs/recordVersion" } } }], "unevaluatedProperties": false },
    "disable": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["local_definition_ref", "expected_record_version"], "properties": { "operation": { "const": "disable" }, "local_definition_ref": { "$ref": "#/$defs/textRef" }, "expected_record_version": { "$ref": "#/$defs/recordVersion" } } }], "unevaluatedProperties": false },
    "rollback": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["local_definition_ref", "revision_ref", "expected_record_version"], "properties": { "operation": { "const": "rollback" }, "local_definition_ref": { "$ref": "#/$defs/textRef" }, "revision_ref": { "$ref": "#/$defs/textRef" }, "expected_record_version": { "$ref": "#/$defs/recordVersion" } } }], "unevaluatedProperties": false },
    "resolve": { "type": "object", "additionalProperties": false, "required": ["schema_version", "operation", "local_definition_ref"], "properties": { "schema_version": { "const": "webenvoy.account-system-owner-operation/v1" }, "operation": { "const": "resolve" }, "local_definition_ref": { "$ref": "#/$defs/textRef" }, "revision_ref": { "$ref": "#/$defs/textRef" }, "historical": { "type": "boolean" } } }
  },
  "x-webenvoy": {
    "owner": "Core owner AccountSystem API",
    "status": "accepted-v1",
    "schema_version": "webenvoy.account-system-owner-operation/v1",
    "compatibility_boundary": "Owner-authenticated POST body for local AccountSystem import, edit, CAS pin, enable, rollback, disable and inspection. Agent credentials cannot call this route.",
    "source_adrs": ["docs/specs/account-system-local-definition-v1.md", "docs/specs/skill-library-lifecycle-v1.md"],
    "field_owners": { "operation": "Core", "template_ref": "Lode fixed template index", "definition": "Core local copy validated against pinned Lode template", "expected_record_version": "Core CAS" }
  }
}
