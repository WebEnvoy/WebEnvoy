{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.webenvoy.dev/harbor-observation-targets-request.schema.json",
  "title": "Harbor observation targets request",
  "description": "The public instance.snapshot envelope for a new observation or a bounded continuation of the same batch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "connection_id", "grant_id", "operation", "task_scope", "profile_ref", "origin", "runtime_session_ref"],
  "properties": {
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "connection_id": { "$ref": "#/$defs/public_ref" },
    "grant_id": { "$ref": "#/$defs/public_ref" },
    "operation": { "const": "instance.snapshot" },
    "task_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "profile_refs", "origins"],
      "properties": {
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" } },
        "profile_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/public_ref" } },
        "origins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "webenvoy-public-origin" } }
      }
    },
    "profile_ref": { "$ref": "#/$defs/public_ref" },
    "origin": { "type": "string", "format": "webenvoy-public-origin" },
    "runtime_session_ref": { "$ref": "#/$defs/public_ref" },
    "page_id": { "$ref": "#/$defs/public_ref" },
    "page_ref": { "$ref": "#/$defs/public_ref" },
    "document_generation": { "type": "integer", "minimum": 1 },
    "observation_ref": { "$ref": "#/$defs/public_ref" },
    "cursor": { "$ref": "#/$defs/cursor_ref" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
  },
  "allOf": [
    {
      "if": { "required": ["cursor"] },
      "then": { "required": ["observation_ref", "page_id", "page_ref", "document_generation"] }
    },
    {
      "if": { "not": { "required": ["cursor"] } },
      "then": { "not": { "required": ["observation_ref"] } }
    }
  ],
  "$defs": {
    "public_ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "cursor_ref": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9:_./-]+$" }
  },
  "x-webenvoy": {
    "owner": "Core public parser with Harbor observation owner",
    "status": "accepted-v1",
    "schema_version": "harbor-observation-targets/v1",
    "compatibility_boundary": "Only the public instance.snapshot envelope is described. Provider handles, internal cursor mappings, and authorization are excluded.",
    "source_adrs": [
      "docs/specs/observation-targets-v1.md",
      "docs/specs/page-navigation-runtime-contract-v1.md"
    ]
  }
}
