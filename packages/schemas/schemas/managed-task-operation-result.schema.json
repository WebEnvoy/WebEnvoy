{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.webenvoy.dev/core/managed-task-operation-result.v1.schema.json",
  "title": "WebEnvoy managed task operation result",
  "description": "Bounded projection of the existing Core Run, task input metadata, result envelope and FailureRecord. It does not define a site-task state machine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schema_version", "operation", "operation_ref", "run", "input", "result", "failure"],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "const": "webenvoy.managed-task-operation-result/v1" },
    "operation": { "type": "string", "enum": ["task.submit", "task.query", "task.stop"] },
    "operation_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "run": { "$ref": "#/$defs/run" },
    "input": { "$ref": "#/$defs/input_summary" },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "https://schemas.webenvoy.dev/core/result-envelope.v0.schema.json" }] },
    "failure": { "oneOf": [{ "type": "null" }, { "$ref": "https://schemas.webenvoy.dev/core/run-record.v0.schema.json#/properties/failure" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "input": { "properties": { "carrier": { "const": "none" } } } } },
      "then": { "properties": { "input": { "properties": { "value_present": { "const": false } } } } }
    },
    {
      "if": { "properties": { "input": { "properties": { "carrier": { "const": "webenvoy.managed-task-inline/v1" } } } } },
      "then": { "properties": { "input": { "properties": { "value_present": { "const": true } } } } }
    }
  ],
  "$defs": {
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "task_intent_ref", "package_ref", "status", "dispatch_state"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "task_intent_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "package_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "$ref": "https://schemas.webenvoy.dev/core/run-record.v0.schema.json#/properties/status" },
        "dispatch_state": { "type": "string", "enum": ["not_dispatched", "dispatched"] }
      }
    },
    "input_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "carrier", "value_present"],
      "properties": {
        "schema_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "carrier": { "type": "string", "enum": ["none", "webenvoy.managed-task-inline/v1"] },
        "value_present": { "type": "boolean" }
      }
    }
  },
  "x-webenvoy": {
    "owner": "Core Managed Task Projection",
    "status": "accepted-v1",
    "schema_version": "webenvoy.managed-task-operation-result/v1",
    "compatibility_boundary": "Bounded Agent projection of an existing Core Run and result; raw input, separate Run state, and additional owner facts are excluded.",
    "source_adrs": ["docs/specs/site-skill-execution-v1.md"],
    "field_owners": { "run": "Core Run", "input": "Core metadata projection", "result": "Core Result Envelope", "failure": "Core FailureRecord" }
  }
}
